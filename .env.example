# Canonical public origin of the site — scheme + host, no trailing slash.
#
# Everything SEO-facing is built from this at BUILD time: sitemap.xml,
# robots.txt, canonical links, OG/Twitter tags and the JSON-LD @ids.
# `output: "export"` produces a static site, so there is no server to read this
# at request time — the value is baked into the HTML by `npm run build`, and
# changing it means rebuilding.
#
# NEXT_PUBLIC_ prefix is required for the same reason: a private env var would
# not survive into the exported output.
#
# Leave it unset and the build falls back to a placeholder and prints a warning.
NEXT_PUBLIC_SITE_URL=https://example.com
